//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   2

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         // &zip_temp_layer MOUSE 500   // ← これを消す / コメントアウト
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <3 3>;
            then-layer = <4>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo 3>, <&mo 1>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo 3>, <&mo 1>;
        };

        // Customed Hold-Tap for SandS

        td_MisCtl_Past: td_MisCtl_Past {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LC(UP_ARROW)>, <&kp LS(LG(V))>, <&none>;

            label = "TD_MISCTL_PAST";
        };

        scroll_hol: scroll_hol {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
            label = "SCROLL_HOL";
        };

        ss_and_mc: ss_and_mc {
            compatible = "zmk,behavior-tap-dance";
            label = "SS_AND_MC";
            #binding-cells = <0>;
            bindings = <&kp LC(UP_ARROW)>, <&kp LS(LG(V))>;
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed
        // When LCLK pressed, exit AML (after 250ms cause by sticky layer
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        middle {
            bindings = <&mkp MCLK>;
            key-positions = <72 73>;
        };

        maru_kakko {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <10 11>;
        };

        maru-kakko2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <11 12>;
        };

        ja-kakko {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <26 27>;
        };

        ja-kakko2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <27 28>;
        };

        kado-kakko {
            bindings = <&kp LESS_THAN>;
            key-positions = <44 45>;
        };

        kado-kakko2 {
            bindings = <&kp GREATER_THAN>;
            key-positions = <45 46>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <20 19>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <19 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC    &kp N1      &kp N2  &kp N3                &kp N4     &kp N5                       &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                        &kp N6            &kp N7  &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB    &kp Q       &kp W   &kp E                 &kp R      &kp T                        &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                      &kp Y             &kp U   &kp I      &kp O    &kp P     &kp ENTER
&kp LSHFT  &kp A       &kp S   &kp D                 &kp F      &kp G      &kp UP_ARROW      &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp LEFT          &kp H             &kp J   &kp K      &kp L    &kp FSLH  &kp MINUS
&kp LALT   &kp Z       &kp X   &kp C                 &kp V      &kp B      &kp DOWN_ARROW    &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp RIGHT         &kp N             &kp M   &kp COMMA  &kp DOT  &kp PLUS  &kp COLON
&kp LGUI   &ss_and_mc          &kp LG(LS(NUMBER_4))  &mkp RCLK  &kp SPACE  &mkp LCLK                                                                 &lt 1 LANGUAGE_2  &lt 2 LANGUAGE_1                                        &kp LS(LG(NUMBER_4))
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_hol>;
            bindings = <
&kp INT_YEN     &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)                  &trans  &trans  &trans  &trans                          &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp TILDE  &kp LS(INT_YEN)   &kp N0
&kp UNDERSCORE  &trans        &trans      &trans         &trans        &trans                         &trans  &trans  &trans  &trans                          &trans         &trans        &trans        &trans     &trans            &trans
&trans          &trans        &trans      &trans         &trans        &trans         &kp C_VOL_UP    &trans  &trans  &trans  &trans    &kp C_BRIGHTNESS_INC  &trans         &trans        &trans        &trans     &kp LC(QUESTION)  &kp UNDERSCORE
&trans          &trans        &trans      &trans         &trans        &trans         &kp C_VOL_DN    &trans  &trans  &trans  &trans    &kp C_BRIGHTNESS_DEC  &trans         &trans        &trans        &trans     &kp EQUAL         &kp SEMICOLON
&trans          &trans                    &trans         &trans        &trans         &trans                                            &trans                &trans                                                                  &trans
            >;
        };

        Fn_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans                        &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans                        &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &kp LC(LEFT_ARROW)  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans    &trans  &trans  &trans  &trans    &kp LC(RIGHT)       &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &trans          &trans  &trans  &trans  &trans                                      &trans              &trans                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp F14 F15>;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans  &none  &none  &none      &none      &none                              &trans  &trans  &trans  &trans               &none     &none     &none     &none      &none  &none
&trans  &none  &none  &none      &none      &none                              &trans  &trans  &trans  &trans               &none     &none     &none     &none      &none  &none
&trans  &none  &none  &mkp RCLK  &mkp LCLK  &msc SCRL_UP    &msc SCRL_LEFT     &trans  &trans  &trans  &trans    &kp PG_UP  &kp HOME  &none     &kp UP    &none      &none  &none
&trans  &none  &none  &mkp MB4   &mkp MB5   &msc SCRL_DOWN  &msc SCRL_RIGHT    &trans  &trans  &trans  &trans    &kp PG_DN  &kp END   &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
&trans  &none         &trans     &trans     &trans          &trans                                               &trans     &kp DEL                                         &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans  &kp C_MUTE                  &trans        &trans        &trans        &trans                                      &trans    &kp DEL                                     &trans
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
